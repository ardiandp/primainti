<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
</IfModule>

<FilesMatch "\.(php|phtml|php\d|phar|pl|py|jsp|asp|aspx|sh|cgi)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
